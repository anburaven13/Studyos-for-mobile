rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile records:
    // Anyone logged in can read public student info, but only the account owner can edit their document.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Usernames registry:
    // Any logged in user can read to verify/search usernames.
    // Client-side writes are strictly FORBIDDEN; must go through atomic backend server API (/api/user/username).
    match /usernames/{username} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Friendships:
    // Only participants listed in the 'users' array can read, update, or remove the friendship/request.
    match /friendships/{friendshipId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.users;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.users;
      allow update: if request.auth != null && request.auth.uid in resource.data.users;
      allow delete: if request.auth != null && request.auth.uid in resource.data.users;
    }

    // Chat Messages:
    // 1. Only authenticated users can read.
    // 2. Sender ID must strictly match the authenticated user UID on create (no identity spoofing).
    // 3. Only the original sender can delete their own message.
    // 4. Edits to sent messages are disabled (immutable chat history).
    match /messages/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null 
                    && request.resource.data.senderId == request.auth.uid
                    && request.resource.data.friendshipId is string;
      allow delete: if request.auth != null && resource.data.senderId == request.auth.uid;
      allow update: if false;
    }
  }
}
